<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/@@main_template/macros/master"
      xml:lang="en"
      i18n:domain="plone"
>
  <body>

    <metal:main fill-slot="content-core">
      <metal:content-core define-macro="content-core"
              tal:define="status context/statusMessage">

        <div tal:define="token context/@@authenticator/token"> 
          <button class="submit-widget btn btn-primary" 
              tal:attributes="onclick view/editTag">
              Edit
          </button>
          <button class="submit-widget btn btn-secondary" 
              tal:attributes="onclick view/shareTag">
              Share
          </button>
          <button class="submit-widget btn btn-secondary"
              tal:attributes="onclick string: window.location='${context/absolute_url}/pdf'">
              PDF
          </button>
          <button 
              tal:attributes="class python: 'submit-widget btn btn-secondary'+[' disabled',''][status.find('satisfy') >= 0];
                              onclick view/transitionTag"
              tal:content="view/transitionLab">
              Transition
          </button>
          <button class="submit-widget btn btn-danger" 
              tal:attributes="onclick view/deleteTag">
              Delete
          </button>
        </div>
        <br>
        <div tal:condition="python: status.find('satisfy') < 0"
           class="row" style="border: 2px solid #f1aeb5 ; background-color: #f8d7da;padding: 2px;">
           <aside class="col-12">
              <div class="portalMessage">
                 <pre style="margin-top: 1em;" tal:content="context/statusMessage">Status message</pre>
              </div>
           </aside>
        </div>
        <div tal:condition="python: status.find('satisfy') > 0"
           class="row" style="border: 2px solid #8cacbb; background-color: #dee7ec;padding: 2px;">
           <aside class="col-12">
              <div class="portalMessage">
                 <pre style="margin-top: 1em;" tal:content="context/statusMessage">Status message</pre>
              </div>
           </aside>
        </div>
        <br>
        <fieldset>
          <table class="table proposals">
            <tr>
              <td width=200><strong>Semester:</strong></td>
              <td colspan=3>2026A</td>
            </tr>
            <tr>
              <td><strong>Principal Investigator:</strong></td>
              <td tal:content="context/pi_name">PI Name</td>
              <td width=100><strong>Email:</strong></td>
              <td tal:content="context/email">email</td>
            </tr>
            <tr>
              <td><strong>Department:</strong></td>
              <td tal:content="context/department">Department</td>
              <td></td><td></td>
            </tr>    
          </table>
        </fieldset>

        <h4>Projects</h4>
        <fieldset>
          <div style="border: 2px solid lightgrey; padding: 5px; margin-bottom: 10pt;" class="proposal-project"
             tal:repeat="project context/projects">
            <table tal:define="projnum repeat/project/number">
              <tr>
                <td width=150><strong>Project No. <span tal:replace="projnum"/>
                  </strong></td>
                <td> <span tal:replace="project/proj_title"/></td>
              </tr>
              <tr>
                <td> <strong>Priority:</strong></td>
                <td> <span tal:replace="project/priority"/></td>
              </tr>
              <tr>
                <td> <strong>Co-Investigators:</strong></td>
                <td> <span tal:replace="project/coIs"/></td>
              </tr>
            </table>
          </div>
        </fieldset>
        
        <tal:widget tal:replace="structure view/widgets/requirements/@@ploneform-render-widget">

        <tal:widget tal:replace="structure view/widgets/conflicts/@@ploneform-render-widget">

        <tal:widget tal:replace="structure view/widgets/justification/@@ploneform-render-widget">


        <fieldset tal:repeat="group view/groups|nothing"
                  tal:attributes="
                    id python:''.join((group.prefix, 'groups.', group.__name__)).replace('.', '-');
                  "
        >
          <legend tal:content="group/label"></legend>
          <tal:block tal:repeat="widget group/widgets/values|nothing">
            <tal:widget tal:replace="structure widget/@@ploneform-render-widget" />
          </tal:block>
        </fieldset>

      </metal:content-core>
    </metal:main>

  </body>
</html>
