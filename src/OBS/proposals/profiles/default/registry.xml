<?xml version="1.0"?>
<registry
    xmlns:i18n="http://xml.zope.org/namespaces/i18n"
    i18n:domain="OBS.proposals">

   <records
       prefix="plone.resources/proposals-fixforms"
       interface="Products.CMFPlone.interfaces.IResourceRegistry">
     <value key="js">++plone++OBS.proposals/datagridhacks.js</value>
   </records>
   <records interface="plone.app.querystring.interfaces.IQueryField" 
             prefix="plone.app.querystring.field.semester">
        <value key="title">Semester</value>
        <value key="description">Filter by academic semester</value>
        <value key="enabled">True</value>
        <value key="sortable">True</value>
        <value key="operations">
            <element>plone.app.querystring.operation.string.is</element>
        </value>
        <value key="group">Metadata</value>
    </records>

</registry>