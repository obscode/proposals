<html xmlns="http://w3.org" xml:lang="en"
      lang="en"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="plone">
<body>

<metal:main fill-slot="main">
    <div tal:define="results context/results">
        
        <!-- Collection Title and Description -->
        <h1 class="documentFirstHeading" tal:content="context/Title">Collection Title</h1>
        <p class="documentDescription" tal:content="context/Description">Collection Description</p>

        <!-- Display message if the collection is empty -->
        <div class="portalMessage info" tal:condition="not: results">
            <p i18n:translate="">No items match this collection's criteria.</p>
        </div>

        <!-- Results Table -->
        <table class="table table-striped data-table table-bordered" id="custom-collection-table" tal:condition="results">
            <thead>
                <tr>
                    <th i18n:translate="">Investigator</th>
                    <th i18n:translate="">State</th>
                    <th i18n:translate="">Dept.</th>
                    <th i18n:translate="">Proj.</th>
                    <th i18n:translate="">run (moon)</th>
                    <th i18n:translate="">Telescope</th>
                    <th i18n:translate="">Inst 1</th>
                    <th i18n:translate="">Inst 2</th>
                    <th i18n:translate="">Service?</th>
                    <th i18n:translate="">In Person?</th>
                    <th i18n:translate="">Nights</th>
                    <th i18n:translate="">Modified</th>
                    <th i18n:translate="">HTML</th>
                    <th i18n:translate="">PDF</th>
                </tr>
            </thead>
            <tbody>
              <tal:block tal:repeat="item results">
                <tr tal:repeat="run item/runs">
                    <!-- Title with clickable link to the item -->
                    <td> <span tal:content="item/pi_name"
                               tal:condition="repeat/run/start">Name</span> </td>
                    <td>
                       <tal:subblock tal:condition="repeat/run/start">
                         <span tal:condition="python: item.review_state()=='private'"
                               style="color: orange;">pending</span>
                         <span tal:condition="python: item.review_state()=='pending'"
                               style="color: green;">submitted</span>
                      </tal:subblock>
                    </td>
                    <td> <span tal:content="item/department"
                               tal:condition="repeat/run/start">department</span> </td>
                    <td> <span tal:content="repeat/run/number">1</span> </td>
                    <td> <span tal:content="python: run['preferred']+'('+run['moon']+')'">D01(0)</span></td>
                    <td> <span tal:content="run/telescope">Baade</span></td>
                    <td> <span tal:content="python: run['inst1'].split(':')[1]"
                               tal:condition="run/inst1">IMACS</span></td>
                    <td> <span tal:content="python: run['inst2'].split(':')[1]"
                               tal:condition="run/inst2">FIRE</span></td>
                    <td> <span tal:content="run/service">No</span></td>
                    <td> <span tal:content="run/in_person">No</span></td>
                    <td> <span tal:content="run/nights">No</span></td>
                    <td> 
                       <span tal:content="python: context.toLocalizedTime(item.ModificationDate())"
                              tal:condition="repeat/run/start">Jan 01, 2026</span>
                    </td>
                    <td>
                        <a tal:attributes="href item/getURL"
                           tal:condition="repeat/run/start">
                           HTML
                        </a>
                    </td>
                    <td>
                        <a tal:attributes="href python: item.getURL()+'/pdf'"
                           tal:condition="repeat/run/start">
                           PDF
                        </a>
                    </td>
                </tr>
              </tal:block>
            </tbody>
        </table>

    </div>
</metal:main>

</body>
</html>
