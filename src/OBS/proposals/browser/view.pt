<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/@@main_template/macros/master"
      xml:lang="en"
      i18n:domain="plone"
>
  <body>

    <metal:main fill-slot="content-core">
      <metal:content-core define-macro="content-core"
              tal:define="status context/statusMessage">

        <div tal:define="buttons view/buttons"
             tal:condition="buttons">
         <button tal:repeat="button buttons"
                 tal:attributes="name button/name;
                                 class button/class;
                                 onclick button/onclick"
                     tal:content="button/name">

        </div>
        <br>
        <div tal:condition="python: status.find('satisfy') < 0 and status.find('submitted') < 0"
           class="row" style="border: 2px solid #f1aeb5 ; background-color: #f8d7da;padding: 2px;">
           <aside class="col-12">
              <div class="portalMessage">
                 <pre style="margin-top: 1em;" tal:content="context/statusMessage">Status message</pre>
              </div>
           </aside>
        </div>
        <div tal:condition="python: status.find('satisfy') > 0 or status.find('submitted') > 0"
           class="row" style="border: 2px solid #8cacbb; background-color: #dee7ec;padding: 2px;">
           <aside class="col-12">
              <div class="portalMessage">
                 <pre style="margin-top: 1em;" tal:content="context/statusMessage">Status message</pre>
              </div>
           </aside>
        </div>
        <br>
        <fieldset>
          <table class="table proposals">
            <tr>
              <td width=200><strong>Semester:</strong></td>
              <td colspan=3>2026A</td>
            </tr>
            <tr>
              <td><strong>Principal Investigator:</strong></td>
              <td tal:content="context/pi_name">PI Name</td>
              <td width=100><strong>Email:</strong></td>
              <td tal:content="context/email">email</td>
            </tr>
            <tr>
              <td><strong>Department:</strong></td>
              <td tal:content="context/department">Department</td>
              <td></td><td></td>
            </tr>    
          </table>
        </fieldset>

        <h4>Projects</h4>
        <fieldset>
          <div style="border: 2px solid lightgrey; padding: 5px; margin-bottom: 10pt;" class="proposal-project"
             tal:repeat="project context/projects">
            <table tal:define="projnum repeat/project/number">
              <tr>
                <td width=150><strong>Project No. <span tal:replace="projnum"/>
                  </strong></td>
                <td> <span tal:replace="project/proj_title"/></td>
              </tr>
              <tr>
                <td> <strong>Priority:</strong></td>
                <td> <span tal:replace="project/priority"/></td>
              </tr>
              <tr>
                <td> <strong>Co-Investigators:</strong></td>
                <td> <span tal:replace="project/coIs"/></td>
              </tr>
              <tr>
                <table class="table table-runs">
                  <thead>
                    <tr>
                      <td>Blocks</td><td>nights</td><td>moon</td><td>telescope</td>
                      <td>instr. one</td><td>instr. two</td><td>service</td>
                      <td>in person</td><td>observers</td>
                    </tr>
                  </thead>
                  <tbody>
                    <tr tal:repeat="row python:context.get_runs(projnum)">
                      <td><span tal:replace="row/preferred"/>
                          (<span tal:replace="row/fromblock"/>-<span tal:replace="row/toblock"/>)
                      </td>
                      <td><span tal:replace="row/nights"/></td>
                      <td><span tal:replace="row/moon"/></td>
                      <td><span tal:replace="row/telescope"/></td>
                      <td><span tal:replace="python:view.instrument(row['inst1'])"/></td>
                      <td><span tal:replace="python:view.instrument(row['inst2'])"/></td>
                      <td><span tal:replace="row/service"/></td>
                      <td><span tal:replace="row/in_person"/></td>
                      <td><span tal:replace="row/observers"/></td>
                    </tr>
                  </tbody>
                </table>
                <div tal:condition="python: context.get_toos(projnum)">
                  <strong>Target of Opportunity (ToO) Requests:</strong>
                  <table class="table table-runs"
                         condition="python: context.get_toos(projnum)">
                    <thead>
                      <tr>
                        <td>Hours</td><td>Telescope(s)</td>
                      </tr>
                    </thead>
                    <tbody>
                      <tr tal:repeat="row python:context.get_toos(projnum)">
                        <td><span tal:replace="row/hours"/></td>
                        <td><span tal:replace="row/telescopes"/></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </tr>
            </table>
          </div>
        </fieldset>
        
        <tal:widget tal:replace="structure view/widgets/requirements/@@ploneform-render-widget">

        <tal:widget tal:replace="structure view/widgets/conflicts/@@ploneform-render-widget">

        <fieldset tal:define="group python:view.groups[0]"
                  tal:attributes="
                    id python:''.join((group.prefix, 'groups.', group.__name__)).replace('.', '-');
                  "
        >
          <legend tal:content="group/label"></legend>
          <tal:block tal:repeat="widget group/widgets/values|nothing">
            <tal:widget tal:replace="structure widget/@@ploneform-render-widget" />
          </tal:block>
        </fieldset>

        <fieldset tal:define="group python:view.groups[1]"
                  tal:attributes="
                    id python:''.join((group.prefix, 'groups.', group.__name__)).replace('.', '-');
                  "
        >
          <legend tal:content="group/label"></legend>
          <tal:block tal:define="targlist context/getTargetsList">
            <span tal:condition="python: len(targlist[0][0]) == 0"
                  tal:content="python: targlist[1]">No specific targets specified</span>
            <table tal:define="header python:targlist[0][0];
                               targets python:targlist[0][1:]"
                               class="table table-striped table-bordered">
              <thead>
                <tr>
                  <th tal:repeat="head header">
                    <span tal:content="head"></span>
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr tal:repeat="target targets">
                  <td tal:repeat="field target">
                    <span tal:content="field"></span>
                  </td>
                </tr>
              </tbody>
            </table>
          </tal:block>
        </fieldset>

      </metal:content-core>
    </metal:main>

  </body>
</html>
