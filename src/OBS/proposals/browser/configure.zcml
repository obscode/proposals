<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="OBS.proposals">

  <!-- Set overrides folder for Just-a-Bunch-Of-Templates product -->
  <include package="z3c.jbot" file="meta.zcml" />
  <browser:jbot
      directory="overrides"
      layer="OBS.proposals.interfaces.IObsProposalsLayer"
      />

  <!-- Publish static files -->
  <plone:static
      name="OBS.proposals"
      type="plone"
      directory="static"
      />

  <browser:page
      name="proposals-controlpanel"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".controlpanel.ProposalsControlPanelFormWrapper"
      permission="cmf.ManagePortal"
      layer="OBS.proposals.interfaces.IObsProposalsLayer"
      />

  <!-- Custom Member folder view -->
  <browser:page
        name="custom-member-area-view"
        for="plone.app.contenttypes.interfaces.IFolder"
        class=".member_area.CustomMemberAreaView"
        template="custom_member_area.pt"
        permission="zope2.View"
        layer="OBS.proposals.interfaces.IObsProposalsLayer"
        />
  <!-- Event listener for new user to set default view -->
  <subscriber
     for="plone.app.contenttypes.interfaces.IFolder
          zope.lifecycleevent.interfaces.IObjectAddedEvent"
     handler=".subscribers.set_member_area_default_view" />

  <adapter
     factory="OBS.proposals.browser.adapters.ForceHomeFolderRedirect"
     for="Products.CMFPlone.interfaces.IPloneSiteRoot
          OBS.proposals.interfaces.IObsProposalsLayer"/>

  <adapter
      factory="OBS.proposals.browser.controlpanel.ProposalsRegistryConfigletPanel"
      name="proposals-controlpanel" />

  <!-- Override the default calendar portlet renderer -->
  <plone:portletRenderer
    portlet="plone.app.event.portlets.portlet_calendar.ICalendarPortlet"
    class=".calendar.MyCustomCalendarRenderer"
    layer="OBS.proposals.interfaces.IObsProposalsLayer"
    />

  <!-- Custom event listing -->
  <browser:page
    name="my-event-list"
    for="*"
    class=".calendar.CustomEventListView"
    template="my_event_listing.pt"
    permission="zope2.View"
  />

  <!-- Yearly Calendar -->
  <browser:page
      for="*"
      name="yearly-calendar"
      class=".calendar.YearlyCalendarView"
      template="yearly_calendar.pt"
      permission="zope2.View"
      />
  
  <!-- Generate Events for each run -->
  <browser:page
    name="GenerateRuns"
    for="Products.CMFPlone.interfaces.IPloneSiteRoot"
    class=".calendar.CreateRunEvents"
    permission="cmf.AddPortalContent"
    layer="OBS.proposals.interfaces.IObsProposalsLayer"
    />



</configure>
