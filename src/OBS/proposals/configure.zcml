<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="OBS.proposals">

  <i18n:registerTranslations directory="locales" />

  <!--
    Be careful if you use general includeDependencies, it can have side effects!
    Better import explicit packages or configurations ;)
  -->
  <!--<includeDependencies package="." />-->

  <include package=".browser" />
  <include package=".content" />

  <include file="permissions.zcml" />

  <genericsetup:registerProfile
      name="default"
      title="OBS.proposals"
      directory="profiles/default"
      description="Installs the OBS.proposals add-on."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.post_install"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="OBS.proposals (uninstall)"
      directory="profiles/uninstall"
      description="Uninstalls the OBS.proposals add-on."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.uninstall"
      />

  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="OBS.proposals-hiddenprofiles"
      />

  <!-- Upgrades -->
  <genericsetup:upgradeStep
    title="Reload FTI info"
    description="Reloads teh typinfo profile for handle new fields"
    source="1000"
    destination="1001"
    profile="OBS.prooposals:default"
    handler="OBS.proposals.content.upgrades.upgrade_types"
  />

  <genericsetup:upgradeStep
    title="Reload FTI info and remove phone"
    description="Reloads teh typinfo profile for handle new fields"
    source="1001"
    destination="1002"
    profile="OBS.prooposals:default"
    handler="OBS.proposals.content.upgrades.upgrade_phone"
  />

  <genericsetup:upgradeStep
    title="Reload FTI info and remove phone"
    description="Reloads teh typinfo profile for handle new fields"
    source="1002"
    destination="1003"
    profile="OBS.prooposals:default"
    handler="OBS.proposals.content.upgrades.upgrade_hours"
  />

  <!-- -*- extra stuff goes here -*- -->

</configure>
